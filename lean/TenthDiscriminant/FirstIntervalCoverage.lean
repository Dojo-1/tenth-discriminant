  rw [List.range'_append_1 (s := 112) (m := 16) (n := 4)]
  rw [List.range'_append_1 (s := 96) (m := 16) (n := 20)]
  rw [List.range'_append_1 (s := 80) (m := 16) (n := 36)]
  rw [List.range'_append_1 (s := 64) (m := 16) (n := 52)]
  rw [List.range'_append_1 (s := 48) (m := 16) (n := 68)]
  rw [List.range'_append_1 (s := 32) (m := 16) (n := 84)]
  rw [List.range'_append_1 (s := 16) (m := 16) (n := 100)]
  rw [List.range'_append_1 (s := 0) (m := 16) (n := 116)]

theorem firstChunk00_coverage : firstChunk00.map Row.p =
    (List.range' 0 132).filter (fun p => decide p.Prime) := by
