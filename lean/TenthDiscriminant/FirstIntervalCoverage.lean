theorem coverage_partition_00 : List.range' 0 132 = [List.range' 0 16, List.range' 16 16, List.range' 32 16, List.range' 48 16, List.range' 64 16, List.range' 80 16, List.range' 96 16, List.range' 112 16, List.range' 128 4].flatten := by
