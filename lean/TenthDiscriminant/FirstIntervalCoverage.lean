  simp only [List.map_cons, List.map_nil, coverage_window_0_16, coverage_window_16_32, coverage_window_32_48, coverage_window_48_64, coverage_window_64_80, coverage_window_80_96, coverage_window_96_112, coverage_window_112_128, coverage_window_128_132,
    List.flatten_cons, List.flatten_nil, List.cons_append, List.nil_append]
  decide +kernel

