import TenthDiscriminant.PrincipalIdealBridge
import Mathlib.RingTheory.AdjoinRoot

/-!
# From a quadratic residue root to the half-integral order

This file constructs a map out of the explicit order generated by
`ω²-ω+(D+1)/4=0`. It does not identify that order with the maximal
ring of integers of a quadratic number field.
-/
namespace TenthDiscriminant

open Polynomial

/-- The polynomial of `ω=(1+√(-D))/2`, with integer coefficients. -/
noncomputable def halfOrderPolynomial (D : Nat) : Polynomial Int :=
  X ^ 2 - X + C (((D : Int) + 1) / 4)

/-- The coefficient is integral precisely in the intended congruence
class, and the familiar discriminant relation is exact over `ℤ`. -/
theorem halfOrder_coefficient_identity (D : Nat)
    (hD : (D : Int) % 4 = 3) :
    4 * (((D : Int) + 1) / 4) = (D : Int) + 1 := by
  omega

private theorem two_ne_zero_of_odd_prime (p : Nat) [Fact p.Prime]
    (hp2 : p ≠ 2) : (2 : ZMod p) ≠ 0 := by
  intro hzero
  have hdiv : p ∣ 2 := (CharP.cast_eq_zero_iff (ZMod p) p 2).mp hzero
  exact hp2 ((Nat.prime_dvd_prime_iff_eq (Fact.out : p.Prime)
    Nat.prime_two).mp hdiv)

/-- The half-integral generator is a root of its integer polynomial
modulo every odd prime at which `z²=-D`. -/
theorem halfOrder_root_of_quadratic_root
    (D p : Nat) [Fact p.Prime] (hD : (D : Int) % 4 = 3)
    (hp2 : p ≠ 2) (z : ZMod p) (hz : z ^ 2 = -(D : ZMod p)) :
    (halfOrderPolynomial D).eval₂ (Int.castRingHom (ZMod p))
      ((1 + z) / 2) = 0 := by
  let t : ZMod p := (1 + z) / 2
  have h2 : (2 : ZMod p) ≠ 0 := two_ne_zero_of_odd_prime p hp2
  have ht : 2 * t - 1 = z := by
    dsimp [t]
    field_simp [h2]
  have hc : (4 : ZMod p) * ((((D : Int) + 1) / 4 : Int) : ZMod p) =
      (D : ZMod p) + 1 := by
    simpa only [Int.cast_mul, Int.cast_ofNat, Int.cast_add, Int.cast_one,
      Int.cast_natCast] using congrArg (fun a : Int => (a : ZMod p))
        (halfOrder_coefficient_identity D hD)
  have h4 : (4 : ZMod p) ≠ 0 := by
    convert pow_ne_zero 2 h2 using 1
    norm_num
  have heq : 4 * (t ^ 2 - t + ((((D : Int) + 1) / 4 : Int) : ZMod p)) = 0 := by
    calc
      _ = (2 * t - 1) ^ 2 + (D : ZMod p) := by linear_combination hc
      _ = 0 := by rw [ht, hz]; ring
  have hroot : t ^ 2 - t + ((((D : Int) + 1) / 4 : Int) : ZMod p) = 0 :=
    (mul_eq_zero.mp heq).resolve_left h4
  change (X ^ 2 - X + C (((D : Int) + 1) / 4)).eval₂
    (Int.castRingHom (ZMod p)) t = 0
  simpa only [eval₂_add, eval₂_sub, eval₂_pow, eval₂_X, eval₂_C]
    using hroot

/-- The root `z` determines a genuine ring map from the explicit
half-integral order to `ZMod p`. The map's existence alone does not
assert that this order is maximal or principal. -/
noncomputable def halfOrderResidueMap
    (D p : Nat) [Fact p.Prime] (hD : (D : Int) % 4 = 3)
    (hp2 : p ≠ 2) (z : ZMod p) (hz : z ^ 2 = -(D : ZMod p)) :
    AdjoinRoot (halfOrderPolynomial D) →+* ZMod p :=
  AdjoinRoot.lift (Int.castRingHom (ZMod p)) ((1 + z) / 2)
    (halfOrder_root_of_quadratic_root D p hD hp2 z hz)

/-- The new map sends the adjoined generator to `(1+z)/2`. -/
theorem halfOrderResidueMap_root
    (D p : Nat) [Fact p.Prime] (hD : (D : Int) % 4 = 3)
    (hp2 : p ≠ 2) (z : ZMod p) (hz : z ^ 2 = -(D : ZMod p)) :
    halfOrderResidueMap D p hD hp2 z hz
      (AdjoinRoot.root (halfOrderPolynomial D)) = (1 + z) / 2 := by
  simp [halfOrderResidueMap, AdjoinRoot.lift_root]

/-- The original residue root is recovered from the order generator.
This makes the change of coordinates reversible at odd primes. -/
theorem halfOrderResidueMap_root_twice_sub_one
    (D p : Nat) [Fact p.Prime] (hD : (D : Int) % 4 = 3)
    (hp2 : p ≠ 2) (z : ZMod p) (hz : z ^ 2 = -(D : ZMod p)) :
    2 * halfOrderResidueMap D p hD hp2 z hz
      (AdjoinRoot.root (halfOrderPolynomial D)) - 1 = z := by
  rw [halfOrderResidueMap_root]
  have h2 : (2 : ZMod p) ≠ 0 := two_ne_zero_of_odd_prime p hp2
  field_simp [h2]

/-- Every such order map is onto because the integer scalars already
surject onto `ZMod p`. This supplies the quotient premise in Phase 10
*for this explicit order*, not yet for the maximal integer ring. -/
theorem halfOrderResidueMap_surjective
    (D p : Nat) [Fact p.Prime] (hD : (D : Int) % 4 = 3)
    (hp2 : p ≠ 2) (z : ZMod p) (hz : z ^ 2 = -(D : ZMod p)) :
    Function.Surjective (halfOrderResidueMap D p hD hp2 z hz) :=
  ZMod.ringHom_surjective _

/-- A ramified-root control. The map exists for `D=15,p=3`, while
Phase 9 proves that principal norm lifting fails there. Thus a map
alone cannot replace the class-number/PID input. -/
theorem fifteen_three_halfOrder_map :
    ∃ f : AdjoinRoot (halfOrderPolynomial 15) →+* ZMod 3,
      Function.Surjective f := by
  exact ⟨halfOrderResidueMap 15 3 (by decide) (by decide) 0 (by decide),
    halfOrderResidueMap_surjective 15 3 (by decide) (by decide) 0 (by decide)⟩

end TenthDiscriminant
