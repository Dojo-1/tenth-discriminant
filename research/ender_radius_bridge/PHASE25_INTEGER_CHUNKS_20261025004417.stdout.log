TenthDiscriminant.quotient_zero_residue_control :
  (TenthDiscriminant.quotientInitial 0).testBit 0 = false ∧
    (TenthDiscriminant.quotientInitial 0).testBit 1 = true ∧
      (TenthDiscriminant.quotientWidePattern 29 3).testBit 0 = false
TenthDiscriminant.quotient_omitted_seed_control :
  179 ∈ TenthDiscriminant.phase35Seeds ∧ 179 ∉ List.take 10 TenthDiscriminant.phase35Seeds
