TenthDiscriminant.quotientInitial_testBit (r k : ℕ) (hr : r < 892371480) :
  (TenthDiscriminant.quotientInitial r).testBit k = true ↔
    1000000 ≤ r + 892371480 * k ∧ r + 892371480 * k < 700000000000
TenthDiscriminant.quotientFilter_retains (M r k current : ℕ) (es : List TenthDiscriminant.QuotientPattern)
  (hk : k < 785)
  (hvalid :
    ∀ e ∈ es,
      0 < e.modulus ∧
        M * e.inverse % e.modulus = 1 ∧ e.wide = TenthDiscriminant.quotientWidePattern e.modulus e.inverse)
  (hno : ∀ e ∈ es, TenthDiscriminant.modularRootTest (r + M * k) e.modulus = false) (hbit : current.testBit k = true) :
  (TenthDiscriminant.quotientFilter r current es).testBit k = true
